# ============================================
# POS Tunisie - Café / Restaurant - Backend
# Copier vers .env : cp .env.example .env
# ============================================

# --- MongoDB ---
MONGODB_URI=mongodb://localhost:27017/pos_tunisie
MONGODB_DATABASE=pos_tunisie

# --- Sécurité / JWT ---
JWT_SECRET=change-me-please-generate-256-bit-secret-min-32-chars!!
JWT_EXPIRATION_MS=86400000

# --- Compte Gérant par défaut (Admin) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123@
ADMIN_PIN=1234
# Clé QR personnelle du gérant (scan = login). Laisser vide pour génération auto au démarrage.
ADMIN_QR_KEY=ADMIN-QR-KEY-CHANGE-ME

# --- Tickets / Imprimante (simulation locale) ---
PRINTER_ENABLED=true
PRINTER_NAME=POS-58mm
TICKET_WIDTH_MM=58
TICKET_CURRENCY=TND
TICKET_LOCALE=fr-TN
TICKET_FOOTER=Merci de votre visite !

# --- Serveur ---
SERVER_PORT=8080

# --- Paiement simulé (aucun vrai gateway) ---
PAYMENT_SIMULATION_MODE=true
PROXIMITY_AUTO_CONFIRM=true

# --- Images catalogue (import local depuis le poste du gérant) ---
# Dossier de stockage, compatible Linux / Windows / macOS. Laisser vide = ~/.pos-tunisie/images
# IMAGES_DIR=
# Taille max d'une image importée (octets, défaut 5 Mo)
# IMAGES_MAX_OCTETS=5242880
